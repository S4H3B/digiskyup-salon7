   # Port the server listens on (Render sets this automatically)
   PORT=5000

   # MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Include the database name (/salon7).
   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/salon7?retryWrites=true&w=majority

   # Long random string used to sign login tokens.
   # Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
   JWT_SECRET=replace-with-a-long-random-string

   # Used ONLY by `npm run seed` to create the first admin account
   ADMIN_EMAIL=admin@example.com
   ADMIN_PASSWORD=change-me-before-seeding
